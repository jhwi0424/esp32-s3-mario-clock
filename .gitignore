# Ignore the "build" directory created by esp-idf
build

# Ignore the user-customized project configuration file.
# (https://docs.espressif.com/projects/esp-idf/en/latest/esp32/api-reference/kconfig.html)
sdkconfig*
# Unignore the default project configuration file.
!sdkconfig.defaults

# Ignore IDE configs
.vscode

dependencies.lock

# Local tool installations, generated firmware, and private board backups.
.tools/
.secrets/
artifacts/
__pycache__/
*.py[cod]
.venv/
*.log
.env
.env.*
**/wifi.json
**/*credentials*.json
**/backups/
*.nvs.bin
